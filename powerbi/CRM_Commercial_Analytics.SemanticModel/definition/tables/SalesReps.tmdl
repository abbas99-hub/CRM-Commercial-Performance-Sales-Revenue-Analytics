	partition SalesReps = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceFolder & "SalesReps.csv"),[Delimiter=",", Columns=6, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"SalesRepID", type text}, {"SalesRepName", type text}, {"ManagerName", type text}, {"TerritoryID", type text}, {"Region", type text}, {"TargetAnnual", Int64.Type}}),
				    Cleaned = fnCleanText(Typed, {"SalesRepID","SalesRepName","ManagerName","TerritoryID","Region"}, {"SalesRepID","TerritoryID"})
				in
				    Cleaned

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

